pysrv () {
   BLUE='\033[0;34m'
   BIGreen='\033[1;92m'
   BIYellow='\033[1;93m'
   NC='\033[0m'
   ip4=$(scutil --nwi | grep address | cut -d':' -f2)
   printf "\n"
   echo "$BLUE Connect @ $BIGreen $ip4:8000"
   printf "\n"
   echo "$BIYellow Control + C to end session"
   echo "$NC"
   python -m http.server
}

pd() {
    local min_args=2

    if [ $# -lt $min_args ]; then
        echo "Usage: $0 requires two arguments, <input_file> <output_file>"
        echo "waiting for input..."
        read -r input_file output_file
    else
        input_file="$1"
        output_file="$2"
    fi
    pandoc "$input_file" -o "$output_file"
}