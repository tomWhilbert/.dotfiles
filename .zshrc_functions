#!/usr/bin/env bash

#* Testing: parameter expansion for git, gq AKA, git quick.  Works can replace or work as alternative to lg ()
gq () {
	git add --all .
	git commit -m "${1:-update}"  #* receive param 1 or if no input 'update'
	git push 
	}

#* diskutil erase function
de () {
	diskutil eraseDisk exFAT "$1" /dev/disk"$2"
	}
dku () {
	diskutil unmountDisk /dev/disk"$1"
	}

#* Disk Usage, Sorted by Size - replacing with dust below
dus () {
		RED='\033[0;31m'
		BLUE='\033[0;34m'
       total=$(du -sh "$1" | cut -f1)
       du -sh "$1"/* | sort -h
       printf "\n"
	   printf "%bTotal Size: %b %s %b in %b %s%b\n" "$BLUE" "$RED" "$total" "$BLUE" "$RED" "$(readlink -f "$1")" "$BLUE"
   	}

